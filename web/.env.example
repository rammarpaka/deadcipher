# Public runtime config for the browser — safe to expose (RLS protects data).
# Real values live in web/.env.local (gitignored) and in Vercel env settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# R2 bucket public domain (image CDN) — include the https:// scheme
NEXT_PUBLIC_IMAGE_CDN=https://cdn.deadcipher.com

# --- Feed tuning (server-side; changing values requires a redeploy) ---
# FEED_LIMIT: stories fetched for the home feed; also the scroll-pagination
# batch size. Default 100 (~2 days of coverage at typical volume).
# FEED_LIMIT=100
# INFINITE_SCROLL: 1 = auto-load older stories past the initial window;
# 0 = single-window feed (previous behavior, no scroll fetching).
# INFINITE_SCROLL=1
# Internal CVE pages (/cve/[id]). 0 = CVE mentions link to NVD instead.
# CVE_PAGES=1
# AI impact insight pane on critical/high story pages.
# IMPACT_INSIGHTS=1
# (Refresh cadence is a code constant: revalidate = 300 in page.tsx —
#  it must match the pipeline cron and can't be an env var.)
