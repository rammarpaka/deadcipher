SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API key (sb_secret_...). Legacy service_role JWT also accepted.
SUPABASE_SECRET_KEY=
# Any OpenAI-compatible endpoint. Defaults target Gemini via its OpenAI layer.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# Max articles ingested per run
# MAX_ITEMS=15
# Max story clusters synthesized per run
# SYNTHESIS_MAX_CLUSTERS=6
# Data retention (days). Rows older than this are deleted each run. 0 disables.
# RETENTION_DAYS=730
# Late merge: re-synthesize stories when follow-up coverage arrives within 24h.
# 0 disables (follow-ups are suppressed instead). Turn off if LLM rate limits bite.
# LATE_MERGE=1
# Cloudflare R2 (article images)
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=deadcipher-images
